flowchart LR
  subgraph Student["Student"]
    direction TB
    S1("Overview")
    S2("Submit Case")
    S3("My Cases")
    S4("Request Follow-up Review")
    S5("Notifications")
    S6("Profile")
    S1 ~~~ S2 ~~~ S3 ~~~ S4 ~~~ S5 ~~~ S6
  end

  subgraph Public["Public / Anonymous User"]
    direction TB
    P1("Submit Anonymous Case")
    P2("Anonymous Tracking")
    P1 ~~~ P2
  end

  subgraph Officer["Student Affairs Officer"]
    direction TB
    O1("Overview")
    O2("Review Queue")
    O3("Request More Info")
    O4("Assign Department")
    O5("All Cases")
    O6("Overdue Cases")
    O7("Reports")
    O8("Profile")
    O9("Close Case")
    O1 ~~~ O2 ~~~ O3 ~~~ O4 ~~~ O5 ~~~ O6 ~~~ O7 ~~~ O8 ~~~ O9
  end

  subgraph Department["Department Staff"]
    direction TB
    D1("Overview")
    D2("My Department Cases")
    D3("Update Progress / Responses")
    D4("Overdue Cases")
    D5("Internal Notes")
    D6("Profile")
    D1 ~~~ D2 ~~~ D3 ~~~ D4 ~~~ D5 ~~~ D6
  end

  subgraph Admin["Admin"]
    direction TB
    A1("Overview")
    A2("Users")
    A3("Departments")
    A4("Categories")
    A5("Permissions / Roles")
    A6("Reports")
    A7("Audit Logs")
    A8("System Performance")
    A9("Settings")
    A1 ~~~ A2 ~~~ A3 ~~~ A4 ~~~ A5 ~~~ A6 ~~~ A7 ~~~ A8 ~~~ A9
  end

  Student ~~~ Public ~~~ Officer ~~~ Department ~~~ Admin

  classDef item fill:#ffffff,stroke:#cbd5e1,color:#111827,stroke-width:1.2px;
  class S1,S2,S3,S4,S5,S6,P1,P2,O1,O2,O3,O4,O5,O6,O7,O8,O9,D1,D2,D3,D4,D5,D6,A1,A2,A3,A4,A5,A6,A7,A8,A9 item;
  style Student fill:#eff6ff,stroke:#bfdbfe,stroke-dasharray:6 5
  style Public fill:#f8fafc,stroke:#cbd5e1,stroke-dasharray:6 5
  style Officer fill:#f0fdfa,stroke:#99f6e4,stroke-dasharray:6 5
  style Department fill:#f0fdf4,stroke:#86efac,stroke-dasharray:6 5
  style Admin fill:#faf5ff,stroke:#d8b4fe,stroke-dasharray:6 5
