%%{init: {
  "theme": "base",
  "themeVariables": {
    "background": "#ffffff",
    "primaryTextColor": "#111827",
    "lineColor": "#2563eb",
    "fontFamily": "Helvetica Neue, Helvetica, Arial, sans-serif"
  },
  "flowchart": {
    "htmlLabels": true,
    "curve": "linear",
    "nodeSpacing": 14,
    "rankSpacing": 22,
    "padding": 8
  }
}}%%
flowchart TB
  subgraph LANES["Responsibility labels"]
    direction LR
    L1["Student / Anonymous User"]
    L2["System"]
    L3["Student Affairs Officer"]
    L4["Department Staff"]
  end

  Start(( ))
  SubmitDetails("Student / Anonymous User<br/><b>Submit case details</b><br/>details + attachments")
  ValidateFields("System<br/><b>Validate fields</b><br/>required fields")
  CreateCaseNumber("System<br/><b>Create case number</b><br/>unique case number")
  AnonymousHandling("System<br/><b>Anonymous handling</b><br/>generate tracking code and store hash if anonymous")
  CreateSlaLog("System<br/><b>Create SLA log</b><br/>initial status log and dueAt")
  NotifyParties("System<br/><b>Notify parties</b><br/>submitter + officer")
  ReviewCase("Student Affairs Officer<br/><b>Review case</b><br/>evidence + category")
  NeedInfo{"Need more info?"}
  RequestInformation("Student Affairs Officer<br/><b>Request information</b><br/>ask for more details")
  ProvideInformation("Student / Anonymous User<br/><b>Provide information</b><br/>supplement details")
  AssignDepartment("Student Affairs Officer<br/><b>Assign department</b><br/>route case owner")
  ViewAssignedCase("Department Staff<br/><b>View assigned case</b><br/>department queue")
  UpdateProgress("Department Staff<br/><b>Update progress</b><br/>notes and response")
  MarkResolved("Department Staff<br/><b>Mark resolved</b><br/>resolution note")
  NotifyStudent("System<br/><b>Notify student</b><br/>resolution notification")
  ReviewResponse("Student / Anonymous User<br/><b>Review response</b><br/>read result")
  Satisfied{"Satisfied?"}
  CloseCase("Student Affairs Officer<br/><b>Close case</b><br/>final officer action")
  FinalStatusLog("System<br/><b>Final status log</b><br/>closed status")
  Reopen("Student / Anonymous User<br/><b>Request follow-up / reopen</b><br/>student is not satisfied")
  End((( )))

  L1 ~~~ L2 ~~~ L3 ~~~ L4
  Start --> SubmitDetails --> ValidateFields --> CreateCaseNumber --> AnonymousHandling --> CreateSlaLog --> NotifyParties --> ReviewCase --> NeedInfo
  NeedInfo -- Yes --> RequestInformation --> ProvideInformation --> ReviewCase
  NeedInfo -- No --> AssignDepartment --> ViewAssignedCase --> UpdateProgress --> MarkResolved --> NotifyStudent --> ReviewResponse --> Satisfied
  Satisfied -- Yes --> CloseCase --> FinalStatusLog --> End
  Satisfied -- "No: reopen case" --> Reopen --> ReviewCase

  classDef student fill:#eff6ff,stroke:#93c5fd,color:#111827,stroke-width:1.3px;
  classDef system fill:#f8fafc,stroke:#cbd5e1,color:#111827,stroke-width:1.3px;
  classDef officer fill:#f0fdfa,stroke:#99f6e4,color:#111827,stroke-width:1.3px;
  classDef dept fill:#f0fdf4,stroke:#86efac,color:#111827,stroke-width:1.3px;
  classDef decision fill:#fff7ed,stroke:#fdba74,color:#111827,stroke-width:1.3px;
  classDef terminal fill:#111827,stroke:#111827,color:#111827;
  class SubmitDetails,ProvideInformation,ReviewResponse,Reopen,L1 student;
  class ValidateFields,CreateCaseNumber,AnonymousHandling,CreateSlaLog,NotifyParties,NotifyStudent,FinalStatusLog,L2 system;
  class ReviewCase,RequestInformation,AssignDepartment,CloseCase,L3 officer;
  class ViewAssignedCase,UpdateProgress,MarkResolved,L4 dept;
  class NeedInfo,Satisfied decision;
  class Start,End terminal;
  style LANES fill:#ffffff,stroke:#d1d5db,stroke-dasharray:6 5
