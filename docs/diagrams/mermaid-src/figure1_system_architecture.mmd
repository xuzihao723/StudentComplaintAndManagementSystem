%%{init: {
  "theme": "base",
  "themeVariables": {
    "background": "#ffffff",
    "primaryColor": "#ffffff",
    "primaryTextColor": "#111827",
    "primaryBorderColor": "#d1d5db",
    "lineColor": "#2563eb",
    "fontFamily": "Helvetica Neue, Helvetica, Arial, sans-serif"
  },
  "flowchart": {
    "htmlLabels": true,
    "curve": "linear",
    "nodeSpacing": 16,
    "rankSpacing": 24,
    "padding": 8
  }
}}%%
flowchart TB
  subgraph TOP[" "]
    direction LR
    subgraph ACTORS[" "]
      direction TB
      Student("Student")
      Anonymous("Anonymous User")
      Officer("Student Affairs Officer")
      DepartmentStaff("Department Staff")
      Admin("Admin")
    end
    subgraph FRONTEND[" "]
      direction LR
      RolePublicUI("Role / Public UI<br/>Element Plus pages")
      CaseViews("Case Views<br/>forms, queues,<br/>case details, drawers")
      ApiClient("API Client<br/>JWT REST calls")
    end
    Security("Security<br/>JWT, BCrypt, RBAC,<br/>optional SSO")
    UniversitySSO("University SSO<br/>optional authentication<br/>provider")
    Controllers("Controllers<br/>Auth, Case,<br/>Admin, Report")
  end

  subgraph BOTTOM[" "]
    direction LR
    Services("Services<br/>Case, Workflow, SLA,<br/>Notify, Report")
    Repositories("Repositories<br/>Spring Data JPA")
    Mysql("MySQL / H2<br/>persistent data")
    FileStorage("File Storage<br/>attachments / evidence files")
    EmailService("Email Service<br/>Resend / SMTP")
    AuditModule("Audit Module<br/>operation tracking")
    AuditLogs("Audit Logs<br/>operation records")
  end

  Student --> RolePublicUI
  Anonymous --> RolePublicUI
  Officer --> RolePublicUI
  DepartmentStaff --> RolePublicUI
  Admin --> RolePublicUI
  RolePublicUI --> CaseViews --> ApiClient --> Security
  Security -. optional .-> UniversitySSO
  Security --> Controllers --> Services --> Repositories --> Mysql
  Services --> FileStorage
  Services --> EmailService
  Services --> AuditModule --> AuditLogs

  classDef actor fill:#ffffff,stroke:#d1d5db,color:#111827,stroke-width:1.3px;
  classDef frontend fill:#ffffff,stroke:#bfdbfe,color:#111827,stroke-width:1.3px;
  classDef backend fill:#ffffff,stroke:#99f6e4,color:#111827,stroke-width:1.3px;
  classDef data fill:#ffffff,stroke:#fed7aa,color:#111827,stroke-width:1.3px;

  class Student,Anonymous,Officer,DepartmentStaff,Admin actor;
  class RolePublicUI,CaseViews,ApiClient frontend;
  class Security,Controllers,Services,Repositories,AuditModule backend;
  class UniversitySSO,Mysql,FileStorage,EmailService,AuditLogs data;

  style TOP fill:#ffffff,stroke:#ffffff
  style BOTTOM fill:#ffffff,stroke:#ffffff
  style ACTORS fill:#f9fafb,stroke:#d1d5db,stroke-dasharray:6 5
  style FRONTEND fill:#eff6ff,stroke:#d1d5db,stroke-dasharray:6 5

  linkStyle 0,1,2,3,4,5,6,7 stroke:#2563eb,stroke-width:1.7px
  linkStyle 8 stroke:#9333ea,stroke-width:1.7px,stroke-dasharray:4 3
  linkStyle 9,10,11,12,13,14 stroke:#16a34a,stroke-width:1.7px
